extends Node
## Música y efectos de sonido. Los archivos están en assets/audio/ y se generan con
## tools/make_audio.py. Los botones suenan solos al pasar por encima y al pulsarlos.
## Music and sound effects. Files live in assets/audio/ and are generated by
## tools/make_audio.py. Buttons play sounds on hover and press automatically.

const PATH := "res://assets/audio/%s.wav"
const POOL_SIZE := 12
## Tiempo mínimo entre dos reproducciones del mismo sonido / Minimum gap between two plays of the same sound
const MIN_GAP := 0.06

var _pool: Array[AudioStreamPlayer] = []
var _next := 0
var _cache := {}
var _last_played := {}
var _loops := {}
var _music: Array[AudioStreamPlayer] = []
var _music_idx := 0
var _music_name := ""
var _ui_quiet_until := 0.0


func _ready() -> void:
	process_mode = Node.PROCESS_MODE_ALWAYS
	for i in POOL_SIZE:
		var p := AudioStreamPlayer.new()
		p.bus = "SFX"
		add_child(p)
		_pool.append(p)
	for i in 2:
		var m := AudioStreamPlayer.new()
		m.bus = "Music"
		m.volume_db = -80.0
		add_child(m)
		_music.append(m)
	get_tree().node_added.connect(_on_node_added)
	get_tree().scene_changed.connect(func() -> void: _ui_quiet_until = _now() + 0.4)


func _now() -> float:
	return Time.get_ticks_msec() / 1000.0


func _stream(sound: String) -> AudioStream:
	if not _cache.has(sound):
		# La música va en .ogg y los efectos en .wav / Music is .ogg, effects are .wav
		var ogg := "res://assets/audio/%s.ogg" % sound
		_cache[sound] = load(ogg if ResourceLoader.exists(ogg) else PATH % sound)
	return _cache[sound]


## Reproduce un efecto. pitch_jitter varía el tono al azar para que no suene repetitivo.
## Plays an effect. pitch_jitter randomly varies the pitch so it doesn't sound repetitive.
func play(sound: String, volume_db := 0.0, pitch_jitter := 0.0) -> void:
	var now := _now()
	if now - float(_last_played.get(sound, -1.0)) < MIN_GAP:
		return
	_last_played[sound] = now
	var p := _pool[_next]
	_next = (_next + 1) % POOL_SIZE
	p.stream = _stream(sound)
	p.volume_db = volume_db
	p.pitch_scale = 1.0 + randf_range(-pitch_jitter, pitch_jitter)
	p.play()


## Enciende o apaga un sonido en bucle (por ejemplo, la aspiradora).
## Turns a looping sound on or off (for example, the vacuum).
func set_loop(sound: String, on: bool, volume_db := -4.0) -> void:
	if on:
		if _loops.has(sound):
			return
		var p := AudioStreamPlayer.new()
		p.bus = "SFX"
		p.stream = _looped(sound)
		p.volume_db = -30.0
		add_child(p)
		p.play()
		create_tween().tween_property(p, "volume_db", volume_db, 0.15)
		_loops[sound] = p
	elif _loops.has(sound):
		var p: AudioStreamPlayer = _loops[sound]
		_loops.erase(sound)
		var tw := create_tween()
		tw.tween_property(p, "volume_db", -40.0, 0.2)
		tw.tween_callback(p.queue_free)


func stop_loops() -> void:
	for sound: String in _loops.keys():
		set_loop(sound, false)


## Cambia de canción con un fundido cruzado de potencia constante (las dos curvas en amplitud, no en
## dB, para que no haya bache ni golpe de volumen). Cada canción recuerda por dónde iba: al volver a
## la música del acto después del plano astral, sigue donde estaba en vez de empezar de cero.
## Switches songs with an equal-power crossfade (both curves in amplitude, not dB, so there's no dip
## or volume jump). Each song remembers where it was: going back to the act music after the astral
## plane, it carries on where it was instead of starting over.
var _positions := {}
## Canciones que siguen por donde iban (las de jefe empiezan siempre por el principio)
## Songs that carry on where they were (boss songs always start from the top)
const RESUME := ["music_dream1", "music_living", "music_school", "music_city", "music_astral", "music_menu"]
var _fade_tw: Tween


func play_music(song: String, fade := 1.5, volume_db := -6.0) -> void:
	muffle(false, 0.6)
	if song == _music_name:
		# La misma canción: solo vuelve a su volumen si se había bajado / Same song: just back to its volume if it was lowered
		if _music[_music_idx].volume_db < volume_db - 0.5:
			fade_music(volume_db, fade)
		return
	var old_name := _music_name
	_music_name = song
	# Si había otro fundido a medias, se corta: si no, ese fundido apagaba (y paraba) la canción nueva
	# cuando se cambiaba dos veces seguidas (p. ej., el sueño del jefe y enseguida la música del jefe)
	# If another crossfade was half-way, cut it: otherwise that fade turned down (and stopped) the new
	# song when switching twice in a row (e.g. the boss dream and right away the boss music)
	for tw: Tween in [_music_tw, _duck_tw, _fade_tw]:
		if tw and tw.is_valid():
			tw.kill()
	var old := _music[_music_idx]
	if old.playing and old_name != "":
		_positions[old_name] = old.get_playback_position()
	_music_idx = 1 - _music_idx
	var new := _music[_music_idx]
	new.stream = _looped(song)
	new.volume_db = -80.0
	var at: float = _positions.get(song, 0.0) if song in RESUME else 0.0
	if new.stream and at >= new.stream.get_length() - 2.0:
		at = 0.0
	new.play(at)
	var old_lin := db_to_linear(old.volume_db)
	var new_lin := db_to_linear(volume_db)
	_music_tw = create_tween()
	_music_tw.tween_method(func(k: float) -> void:
		new.volume_db = linear_to_db(maxf(0.0001, new_lin * sin(k * PI / 2.0)))
		old.volume_db = linear_to_db(maxf(0.0001, old_lin * cos(k * PI / 2.0))), 0.0, 1.0, maxf(0.05, fade))
	_music_tw.tween_callback(old.stop)


## El leitmotiv de un personaje, bien claro: la música baja un momento y luego vuelve a donde estaba
## A character's leitmotif, nice and clear: the music dips for a moment and then returns to where it was
func leitmotif(who: String, volume_db := 1.0, duck_db := -20.0) -> void:
	var player := _music[_music_idx]
	if _duck_tw == null or not _duck_tw.is_valid():
		_duck_back = player.volume_db
	if _duck_tw and _duck_tw.is_valid():
		_duck_tw.kill()
	play("giver_" + who, volume_db)
	_duck_tw = create_tween()
	_duck_tw.tween_property(player, "volume_db", minf(_duck_back, duck_db), 0.25)
	_duck_tw.tween_interval(2.4)
	_duck_tw.tween_property(player, "volume_db", _duck_back, 1.2)


var _duck_tw: Tween
var _music_tw: Tween
var _duck_back := -6.0


func fade_music(volume_db: float, time := 1.0) -> void:
	if _fade_tw and _fade_tw.is_valid():
		_fade_tw.kill()
	var p := _music[_music_idx]
	var from := db_to_linear(p.volume_db)
	var to := db_to_linear(volume_db)
	_fade_tw = create_tween()
	_fade_tw.tween_method(func(k: float) -> void:
		p.volume_db = linear_to_db(maxf(0.0001, lerpf(from, to, k))), 0.0, 1.0, maxf(0.05, time)).set_trans(Tween.TRANS_SINE)


## La música y la aspiradora ya vienen marcadas como bucle en su .import.
## The music and the vacuum are already marked as loops in their .import files.
var _muffle_tw: Tween


## Apaga la música como si sonara en otra habitación (o la devuelve) / Muffles the music as if playing in another room (or brings it back)
func muffle(on: bool, time := 0.35) -> void:
	var mi := AudioServer.get_bus_index("Music")
	if mi == -1 or AudioServer.get_bus_effect_count(mi) == 0:
		return
	var lp := AudioServer.get_bus_effect(mi, 0) as AudioEffectLowPassFilter
	if lp == null:
		return
	if _muffle_tw:
		_muffle_tw.kill()
	_muffle_tw = create_tween()
	_muffle_tw.tween_method(func(hz: float) -> void: lp.cutoff_hz = hz, lp.cutoff_hz, 700.0 if on else 20000.0, time) \
		.set_trans(Tween.TRANS_SINE).set_ease(Tween.EASE_OUT if on else Tween.EASE_IN)


func _looped(sound: String) -> AudioStream:
	return _stream(sound)


# --- Sonidos de la interfaz / Interface sounds -------------------------------

func _on_node_added(node: Node) -> void:
	if node is BaseButton:
		var b := node as BaseButton
		b.focus_entered.connect(_ui_hover)
		b.mouse_entered.connect(_ui_hover)
		b.pressed.connect(func() -> void: play("ui_click", -10.0))


func _ui_hover() -> void:
	if _now() < _ui_quiet_until:
		return
	play("ui_hover", -18.0, 0.03)


## Para la música y los efectos antes de cerrar, para que el motor los libere bien.
## Stops music and effects before closing, so the engine releases them cleanly.
func shutdown() -> void:
	for p: AudioStreamPlayer in _music + _pool:
		p.stop()
		p.stream = null
	for p: AudioStreamPlayer in _loops.values():
		p.stop()
		p.stream = null
	_loops.clear()
	_cache.clear()


## Cierra el juego en silencio / Quits the game quietly
func quit_game() -> void:
	shutdown()
	await get_tree().process_frame
	await get_tree().process_frame
	get_tree().quit()
