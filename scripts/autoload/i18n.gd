	"UP_SILLY_LAPTOP_NAME": {"es": "Exploit", "en": "Exploit"},
	"UP_SILLY_LAPTOP_DESC": {"es": "Puedes tener {turrets} torreta(s) más. Cada disparo de torreta tiene un {chance} % de congelar al enemigo {secs} s.", "en": "You can have {turrets} more turret(s). Every turret shot has a {chance}% chance to freeze the enemy for {secs} s."},
