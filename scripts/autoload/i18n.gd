	"KW_CRIT_NAME": {"es": "Crítico", "en": "Critical"},
	"KW_CRIT_DESC": {"es": "Golpe que hace más daño de lo normal (x1,75).", "en": "A hit that deals more damage than usual (x1.75)."},
	"KW_DEFENSE_NAME": {"es": "Defensa", "en": "Defense"},
	"KW_DEFENSE_DESC": {"es": "Resta daño a cada golpe que recibes, pero nunca más de la mitad del golpe.", "en": "Takes damage off every hit you receive, but never more than half the hit."},
	"KW_LUCK_NAME": {"es": "Suerte", "en": "Luck"},
	"KW_LUCK_DESC": {"es": "Mejoras de nivel más raras, más objetos de los enemigos y más probabilidad de que vuelvan los personajes que ya te ayudaron.", "en": "Rarer level-up upgrades, more items from enemies and a better chance that characters who already helped you come back."},
	"KW_ATTACK_SPEED_NAME": {"es": "Velocidad de ataque", "en": "Attack speed"},
	"KW_ATTACK_SPEED_DESC": {"es": "Tus armas atacan más a menudo.", "en": "Your weapons attack more often."},
	"KW_REGEN_NAME": {"es": "Regeneración", "en": "Regeneration"},
	"KW_REGEN_DESC": {"es": "Recuperas esa cantidad de vida cada 5 segundos.", "en": "You recover that much health every 5 seconds."},
	"KW_LIFESTEAL_NAME": {"es": "Robo de salud", "en": "Lifesteal"},
	"KW_LIFESTEAL_DESC": {"es": "Probabilidad de curarte 1 de vida cada vez que golpeas.", "en": "Chance to heal 1 health every time you hit."},
	"KW_REALITY_NAME": {"es": "Realidad Fragmentada", "en": "Fragmented Reality"},
	"KW_REALITY_DESC": {"es": "La moneda de los sueños: sirve para comprarle a Charo y para dar propinas. Solo dura una partida.", "en": "The currency of dreams: spend it at Charo's and on tips. It only lasts one run."},
	"KW_ROOTED_NAME": {"es": "Inmovilizado", "en": "Rooted"},
	"KW_ROOTED_DESC": {"es": "Te quedas clavado en el sitio un momento: no puedes moverte, pero tus armas siguen atacando.", "en": "You're stuck to the spot for a moment: you can't move, but your weapons keep attacking."},
	"STENCH_LOST": {"es": "¡Qué peste!", "en": "What a stink!"},
	"BEST_CYBER_DESC": {"es": "Esquiva de un salto justo cuando le voy a dar. Si se me queda cerca me hackea y me deja peor en algo, y si no lo derroto rápido, el virus me hace daño.", "en": "It dashes out of the way right when I'm about to hit it. If it stays close it hacks me and makes me worse at something, and if I don't beat it quickly, the virus hurts me."},
	"HACK_VIRUS": {"es": "¡Virus!", "en": "Virus!"},
	"BEST_BOSS_CHEF_NAME": {"es": "El Chef", "en": "The Chef"},
	"BEST_BOSS_CHEF_DESC": {"es": "Salió de la tele y se parecía a mí de mayor. Sus cuchillos me hacían sangrar, su sartén me dejaba clavado y sus platos rotos cortaban el suelo.", "en": "He came out of the TV and looked like a grown-up me. His knives made me bleed, his pan left me stuck and his broken plates cut up the floor."},
	"BEST_GOLDEN_FOOX_NAME": {"es": "Foox dorado", "en": "Golden Foox"},
	"BEST_GOLDEN_FOOX_DESC": {"es": "Corre muchísimo y no hace daño. Si lo pillo antes de que se esfume, me llueven estrellas.", "en": "It runs so fast and never hurts. If I catch it before it fades away, it rains stars."},
	"BEST_ELITE_NAME": {"es": "Élite", "en": "Elite"},
	"BEST_ELITE_DESC": {"es": "Algunos sueños se ponen feos de verdad: cuernos, más tamaño y el triple de aguante. Por lo menos sueltan más estrellas. El color me dice qué hacen:", "en": "Some dreams get really ugly: horns, bigger size and triple toughness. At least they drop more stars. Their colour tells me what they do:"},
	"BEST_ELITE_SPLIT": {"es": "Naranja: al caer se parte en dos Foox.", "en": "Orange: when it falls it splits into two Foox."},
	"BEST_ELITE_PUDDLE": {"es": "Azul: va dejando charcos que me frenan si los piso.", "en": "Blue: leaves puddles that slow me down if I step in them."},
	"BEST_ELITE_HASTE": {"es": "Morado: corre muchísimo más que los demás.", "en": "Purple: runs much faster than the rest."},
	"BESTIARY_UNLOCK_ALL": {"es": "Desbloquear todo", "en": "Unlock everything"},
	"BEST_BOSS_BED_NAME": {"es": "La cama", "en": "The bed"},
	"BEST_BOSS_BED_DESC": {"es": "Mi propia cama quiere aplastarme. Cuando salta, tengo que salir del círculo antes de que caiga.", "en": "My own bed wants to squash me. When it jumps, I have to get out of the circle before it lands."},
	"BEST_BOSS_SHELF_NAME": {"es": "La estantería", "en": "The bookshelf"},
	"BEST_BOSS_SHELF_DESC": {"es": "Me tira mis propios cuentos. Mejor mirar las rayas antes de que salgan volando.", "en": "It throws my own storybooks at me. Better watch the lines before they fly."},
	"BEST_BOSS_CHEST_NAME": {"es": "El baúl de juguetes", "en": "The toy chest"},
	"BEST_BOSS_CHEST_DESC": {"es": "A mí no me hace nada, pero no para de sacar juguetes malos. Tengo que alcanzarlo.", "en": "It never hurts me, but it keeps letting nasty toys out. I have to catch it."},

