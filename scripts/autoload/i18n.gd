	"UP_AD_LAPTOP_NAME": {"es": "Torreta de cobro", "en": "Debt-collector turret"},
	"UP_AD_LAPTOP_DESC": {"es": "{extra} % de ganar 1 más de Realidad Fragmentada. Aparece en el mapa una torreta que hace poco daño pero busca a los enemigos con menos vida y remata a los que tienen menos del 15 %; cada remate da {cash} de Realidad Fragmentada.", "en": "{extra}% chance to gain 1 more Fragmented Reality. A turret appears on the map that deals little damage but targets the weakest enemies and finishes off those under 15% health; each finish gives {cash} Fragmented Reality."},
	"UP_PINCHE_LAPTOP_NAME": {"es": "Fogón portátil", "en": "Camping stove"},
