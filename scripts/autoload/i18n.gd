	# --- Sueño 20: noir y Evil Ad / Dream 20: noir and Evil Ad ---
	"CITY_NOIR": {"es": "Noir retrofuturista", "en": "Retro-futurist noir"},
	"NOIR_HINT": {"es": "F seguir · Esc saltar", "en": "F continue · Esc skip"},
	"NOIR_1": {"es": "Esta aventura onírica comienza a superarme, no sé si podré seguir entrelazando sueños.", "en": "This dream adventure is starting to get the better of me. I don't know if I can keep weaving dreams together."},
	"NOIR_2": {"es": "Todo empezó en mi cuarto. La cama, la estantería, el cofre... hasta los muebles buscaban acabar conmigo.", "en": "It all started in my room. The bed, the shelf, the chest... even the furniture was out to get me."},
	"NOIR_3": {"es": "En el salón me vi a mí, de adulto, sufría...", "en": "In the living room I saw myself, as a grown-up. Suffering..."},
	"NOIR_4": {"es": "En el colegio... Un OVNI trató de abducirme, si le hubiera dejado, ¿a dónde me habría llevado?", "en": "At school... A UFO tried to abduct me. If I'd let it, where would it have taken me?"},
	"NOIR_5": {"es": "Por el camino hice amigos raros. Un futbolista, un matón, una hacker, un médico... gente que, podría ser yo en un futuro, pero creo que ninguna versión me gusta.", "en": "Along the way I made strange friends. A footballer, a bully, a hacker, a doctor... people I could become one day, but I don't think I like any of those versions."},
	"NOIR_6": {"es": "Pero alguien se salía de la norma, ese robot...", "en": "But someone broke the mould. That robot..."},
	"NOIR_7": {"es": "Lo notaba en el aire. Olía a cartel luminoso, a letra pequeña... a anuncio.", "en": "I could smell it in the air. Neon signs, small print... advertising."},
	"NOIR_8": {"es": "Me calé el sombrero. Esta noche, alguien iba a cancelar su suscripción.", "en": "I tipped my hat. Tonight, somebody was cancelling their subscription."},
	"BOSS_EVIL_AD_NAME": {"es": "Evil Ad", "en": "Evil Ad"},
	"BOSS_EVIL_AD_SUB": {"es": "OfERta FInaL: nO dESSpERtAr nuNCa. ¡TotAlmENtE grAtiS!", "en": "FiNaL oFFeR: nEvVeR wAkE uP. AbSoLuTeLy FrEe!"},
	"BEST_BOSS_EVIL_AD_NAME": {"es": "Evil Ad", "en": "Evil Ad"},
	"BEST_BOSS_EVIL_AD_DESC": {"es": "Mr. Ad perdió la cabeza definitivamente, sucumbió a sus instintos de la publicidad predatoria y viendo que yo era más fuerte que su publicidad, decidió que debía acabar conmigo", "en": "Mr. Ad finally lost his mind. He gave in to his predatory advertising instincts and, seeing I was stronger than his ads, decided he had to finish me off."},
	"EVIL_TALK_1": {"es": "¡Últimas novedades! Un intruso en la ciudad ha llegado demasiado lejos. Es hora de dejarle claro que debe resignarse ante lo impuesto por la sociedad", "en": "Breaking news! An intruder in the city has gone too far. It's time to make it clear he must give in to what society imposes."},
	"EVIL_TALK_2": {"es": "¿Mr. Ad...? ¿Qué te ha pasado?", "en": "Mr. Ad...? What happened to you?"},
	"EVIL_TALK_3": {"es": "Tanto sueño, ambición, visión de futuro... QuIERes Verr Lo QuE TIeEnes dELanTe?¿??", "en": "So much dreaming, ambition, vision for the future... WaNnA SeEe WhAt's RiGhT iN fRoNt Of YoU?¿??"},
	"EVIL_TALK_4": {"es": "¿De qué hablas?", "en": "What are you talking about?"},
	"EVIL_TALK_5": {"es": "¡AAAAAAHHHHHHH! Se acabó para ti, es hora de que sucumbas al consumismo maldito crío, ¿por qué tratas de evitar al sistema?", "en": "AAAAAAHHHHHHH! It's over for you. Time to give in to consumerism, you wretched brat. Why do you try to dodge the system?"},
	"EVIL_TALK_6": {"es": "En serio que no te entiendo, yo solo estoy viviendo mi vida haciendo lo que me gusta, supongo que debo acabar contigo aquí y ahora.", "en": "Seriously, I don't get you. I'm just living my life doing what I love. I guess I have to finish you here and now."},
	"EVIL_AD_SPAM": {"es": "¡Un mensaje de nuestros patrocinadores!", "en": "A word from our sponsors!"},
	"SPAM_1": {"es": "¡HAS GANADO!", "en": "YOU WON!"},
	"SPAM_2": {"es": "¡OFERTA!", "en": "SPECIAL OFFER!"},
	"SPAM_3": {"es": "¡CLICK AQUÍ!", "en": "CLICK HERE!"},
	"SPAM_4": {"es": "¡99% DTO!", "en": "99% OFF!"},
	"SPAM_5": {"es": "¿SEGURO QUE QUIERES DESPERTAR?", "en": "SURE YOU WANT TO WAKE UP?"},
	"SPAM_6": {"es": "¡GRATIS!*", "en": "FREE!*"},
	"SPAM_7": {"es": "¡SOLO HOY!", "en": "TODAY ONLY!"},
	"SPAM_8": {"es": "¡SUSCRÍBETE!", "en": "SUBSCRIBE!"},
	"SPAM_CLOSE": {"es": "*no se puede cancelar", "en": "*cannot be cancelled"},
	"EVIL_AD_SHOUT": {"es": "¡NO CAMBIES DE CANAL!", "en": "DON'T CHANGE THE CHANNEL!"},
	"EVIL_AD_DELIRIUM": {"es": "¡¡SUPER-MEGA-OFERTAAA!!", "en": "SUPER-MEGA-DEALLL!!"},
	"EVIL_AD_BREAK": {"es": "Volvemos después de la publicidad...", "en": "Back after these messages..."},
	"EVIL_AD_KILLED_SUB": {"es": "Evil Ad se apaga. Fin de la emisión. Es hora de despertar.", "en": "Evil Ad switches off. End of broadcast. Time to wake up."},
	"EVIL_AD_SURVIVED_SUB": {"es": "Aguantaste toda la teletienda. La señal se corta. Es hora de despertar.", "en": "You sat through the whole infomercial. The signal cuts out. Time to wake up."},
	"ACH_EVIL_AD_NAME": {"es": "Fin de la emisión", "en": "End of broadcast"},
	"ACH_EVIL_AD_DESC": {"es": "Derrota a Evil Ad en el último sueño (aguantar hasta el final no vale).", "en": "Defeat Evil Ad in the last dream (holding out till the end doesn't count)."},
	"ACT4_CLEAR_TITLE": {"es": "Fin del Acto 4", "en": "End of Act 4"},
	"FINAL_SUB": {"es": "La ciudad se queda en silencio. Es hora de despertar.", "en": "The city falls silent. Time to wake up."},
