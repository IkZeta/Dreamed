; Dreamed — Godot 4 project
config_version=5

[application]

config/name="Dreamed"
config/description="Cada oleada, un sueño dentro de otro. / Every wave, a dream within a dream."
run/main_scene="res://scenes/main_menu.tscn"
config/features=PackedStringArray("4.7")

[autoload]

I18n="*res://scripts/autoload/i18n.gd"
Settings="*res://scripts/autoload/settings.gd"
GameState="*res://scripts/autoload/game_state.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/window_width_override=1600
window/size/window_height_override=900
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[internationalization]

locale/fallback="en"

[rendering]

anti_aliasing/quality/msaa_2d=2
